# ============================================================
# AZTRANSFER.AZ — Environment Variables
# ============================================================

# Next.js (Frontend)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
NEXT_PUBLIC_API_URL=https://aztransfer.az/api

# Database (MySQL/MariaDB)
DB_HOST=localhost
DB_NAME=aztransfer
DB_USER=aztransfer_user
DB_PASS=your_database_password_here

# JWT Authentication
JWT_SECRET=your-random-secret-key-change-this-in-production

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=info@aztransfer.az
SMTP_PASS=your_email_password_here
SMTP_FROM=info@aztransfer.az
SMTP_FROM_NAME=AZTRANSFER.AZ

# WhatsApp Business API (optional)
WHATSAPP_API_TOKEN=your_whatsapp_token_here
WHATSAPP_PHONE_ID=your_phone_id_here

# Google Maps API (Server-side)
GOOGLE_MAPS_SERVER_KEY=your_server_side_maps_key_here
